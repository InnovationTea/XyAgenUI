{
  "name": "agenui-reply-validator",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agenui": "scripts/cli.mjs"
  },
  "scripts": {
    "build": "node scripts/build-resources.mjs && node scripts/build-visuals.mjs && node scripts/build-examples.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate:examples": "node scripts/check-examples.mjs",
    "validate:visuals": "node scripts/check-visuals.mjs",
    "audit": "node scripts/audit.mjs",
    "online": "node scripts/online.mjs",
    "start": "node scripts/service.mjs",
    "export:skill": "node scripts/export-skill.mjs",
    "check:skill": "node scripts/export-skill.mjs --check",
    "verify:skill": "node scripts/verify-skill.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "description": "Independent AGenUI v0.9 single-reply validation core, CLI and HTTP transport",
  "exports": "./scripts/lib/index.mjs"
}
