{
  "templateId": "Button.harmony-minimal.v1",
  "component": "Button",
  "status": "candidate-no-device-test",
  "authority": "项目设计模板，不是官方新增组件或 A2UI 字段",
  "unitProfile": {
    "name": "harmony-vp",
    "unit": "vp",
    "unitlessDefault": "vp",
    "valueType": "string",
    "lengthScale": 1.0,
    "fontScale": 1.0,
    "semanticsConfirmed": true,
    "confirmationBasis": "用户已确认当前端侧支持vp，尺寸字符串无单位时默认vp；属于项目宿主约定",
    "nativeVisualQA": false,
    "accessibilityFontScaleQA": false
  },
  "scene": "主操作、次操作、文字操作；同一区域建议最多一个主操作。",
  "dynamicContract": "本例调用你宿主已声明的 sendMsgToXiaoyi；点击时执行。",
  "boundary": "动作是项目宿主扩展，不冒充官方内置；不可把颜色写到 Button 当文字色；禁用/加载态交给实际支持接口。",
  "requirements": [
    "宿主注册 sendMsgToXiaoyi；按当前契约执行",
    "样式按48vp目标输出；真实触控区域仍需端侧量测"
  ],
  "mutableFields": [
    "id",
    "text/content/label：仅该组件支持的字段",
    "data binding / child IDs / action：保持契约"
  ],
  "stylePolicy": "固定选中变体的样式；变化的是内容、绑定与合法引用。整体换密度或颜色方案，禁止随机单项漂移。",
  "focus": {
    "id": "focus",
    "component": "Button",
    "child": "button_label",
    "variant": "primary",
    "action": {
      "functionCall": {
        "call": "sendMsgToXiaoyi",
        "args": {
          "query": "请根据当前条件继续生成一份采购清单。"
        },
        "returnType": "void"
      }
    },
    "styles": {
      "min-height": "48vp",
      "padding": "12vp 20vp 12vp 20vp",
      "border-radius": "20vp",
      "align-self": "center",
      "background-color": "#16181D"
    }
  },
  "dependencies": [
    {
      "id": "button_label",
      "component": "Text",
      "text": "按当前条件生成清单",
      "variant": "body",
      "styles": {
        "font-size": "16vp",
        "font-weight": "bold",
        "color": "#FFFFFF",
        "line-height": 1.3,
        "text-align": "center"
      }
    }
  ],
  "initialData": {},
  "variants": {
    "secondary": {
      "focus": {
        "variant": "default",
        "styles": {
          "background-color": "#FFFFFF",
          "border-color": "#16181D",
          "border-width": "1vp"
        }
      },
      "nodes": {
        "button_label": {
          "styles": {
            "color": "#16181D"
          }
        }
      }
    },
    "text": {
      "focus": {
        "variant": "borderless",
        "styles": {
          "background-color": "#FFFFFF00"
        }
      },
      "nodes": {
        "button_label": {
          "styles": {
            "color": "#0A59F7"
          }
        }
      }
    }
  },
  "exampleFile": "../examples/harmony-candidate/Button.jsonl"
}
